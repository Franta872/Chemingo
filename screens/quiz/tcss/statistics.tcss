StatisticsScreen {
    align: center middle;

    #statistics-container {
        width: 60;
        height: 30;
        border: tall $background-lighten-2;
        background: $surface;
        align: center middle;
        align-horizontal: center;
    }
    Tree {
        background: $surface;
        margin: 1;
        padding: 0 1 1 1;
    }
    #statistics-label {
        width: auto;
        align-horizontal: center;
        text-style: bold underline;
        margin: 0;
    }
    .statistics-center-container {
        align: center middle;
        height: auto;
    }
}